<?xml version="1.0" encoding="UTF-8"?>
<!--
  Android Lint configuration.

  This is a JVM library with no Android sources. Lint runs here for the checks that hold code to the
  contracts `androidx.annotation` states - `RestrictedApi`, `Range`, `VisibleForTests` - and for the
  ones the Compose runtime publishes alongside itself. Every check runs at its own severity; only the
  entries below, which turn checks off, change behavior.
-->
<lint>
    <!--
      Stock dependency-freshness checks: this project pins versions deliberately through the version
      catalog. With warningsAsErrors they would otherwise break the build when a newer release appears
      upstream. These are the only stock Android Lint checks that act on a JVM module's catalog.
    -->
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />
    <!-- Sources a code generator writes (Room, through KSP) are not ours to edit, so no check reads them. -->
    <issue id="all">
        <ignore path="**/build/generated/ksp/**" />
    </issue>
</lint>
