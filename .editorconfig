root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{yml,yaml,toml}]
indent_size = 2

[*.{kt,kts}]
max_line_length = 120
# PascalCase @Composable functions are idiomatic Compose; do not flag them as bad function names.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Annotated function types (e.g. `@Composable @SwingComposable () -> Unit`) hit a ktlint conflict:
# the `annotation` rule reformats them onto multiple lines, which `function-type-modifier-spacing`
# then rejects, so neither check nor format can ever converge. We disable the spacing rule rather
# than the layout one. These types are pervasive in this Compose-based library.
ktlint_standard_function-type-modifier-spacing = disabled

# The forked AndroidX animation-core sources under animation/core keep the format AndroidX publishes them
# in so a re-sync diff stays readable alongside their documented adoption edits. ktlint's standard ruleset
# encodes a different format and would rewrite them away from that, so it is off for them.
[swing-ui-animation-core/src/{main,test}/**/animation/core/**.kt]
max_line_length = 100
ktlint_standard = disabled

# The copied compose-rules helpers in swing-ui-detekt keep upstream's format
# so a re-sync diff stays readable. ktlint skips them here; some carry a file-level detekt suppression.
[swing-ui-detekt/src/main/**/{psi,runtime}/{Composables.analysis,ComposeFqNames,KotlinFqNames,KtCallExpressions.analysis,KtDotQualifiedExpressions.analysis,KtExpressions.analysis,KtLambdaExpressions.analysis,KtProperties.analysis,KtSimpleNameExpressions.analysis}.kt]
max_line_length = 100
ktlint_standard = disabled

# Tests host their body in a trailing-lambda call (e.g. `fun x() = runComposeSwingTest {`). Keep that
# single-expression body on the signature line instead of wrapping it after `=`, so the test reads as
# its name followed directly by the scenario. Only the wrapping of an expression body that already
# fits the signature line is relaxed; the line-length limit and every other rule still apply.
[{swing-ui,swing-ui-test}/src/test/**.{kt,kts}]
ktlint_function_signature_body_expression_wrapping = default
